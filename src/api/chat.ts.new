/**
 * Chat API
 * This file provides type definitions and utilities for chat functionality
 */

/**
 * ChatMessage interface
 * Represents a conversation message with AI/user distinction
 */
export interface ChatMessage {
  id: number;
  user_id: string;         // User identifier - chat_messages.user_id
  session_id?: number;     // Optional session grouping - chat_messages.session_id
  is_ai: boolean;          // Message source indicator - chat_messages.is_ai
  message: string;         // Message content - chat_messages.message
  timestamp: string;       // Message timestamp - chat_messages.timestamp
  updated_at?: string;     // Auto-generated timestamp
}

/**
 * Chat Session interface for conversation management
 * Groups related messages for context and organization
 */
export interface ChatSession {
  id: number;
  user_id: string;
  title?: string;
  started_at: string;
  updated_at?: string;
}

// Chat utilities and helper functions

/**
 * Creates a new user message object
 * @param userId - User identifier
 * @param message - Message content
 * @param sessionId - Optional session identifier
 * @returns Chat message object ready for saving
 */
export const createUserMessage = (
  userId: string, 
  message: string, 
  sessionId?: number
): Omit<ChatMessage, 'id'> => {
  return {
    user_id: userId,
    session_id: sessionId,
    message,
    is_ai: false,
    timestamp: new Date().toISOString(),
  };
};

/**
 * Creates a new AI message object
 * @param userId - User identifier
 * @param message - AI response content
 * @param sessionId - Optional session identifier
 * @returns Chat message object ready for saving
 */
export const createAIMessage = (
  userId: string, 
  message: string, 
  sessionId?: number
): Omit<ChatMessage, 'id'> => {
  return {
    user_id: userId,
    session_id: sessionId,
    message,
    is_ai: true,
    timestamp: new Date().toISOString(),
  };
};

/**
 * Format message timestamp for display
 * @param message - Chat message
 * @returns Formatted time string
 */
export const formatMessageTime = (message: ChatMessage): string => {
  try {
    const date = new Date(message.timestamp);
    const hours = String(date.getHours()).padStart(2, '0');
    const minutes = String(date.getMinutes()).padStart(2, '0');
    return `${hours}:${minutes}`;
  } catch {
    return '';
  }
};

/**
 * Format full message date for conversation headers
 * @param message - Chat message
 * @returns Formatted date string
 */
export const formatMessageDate = (message: ChatMessage): string => {
  try {
    const date = new Date(message.timestamp);
    return date.toLocaleDateString(undefined, { 
      weekday: 'short', 
      month: 'short', 
      day: 'numeric' 
    });
  } catch {
    return '';
  }
};

/**
 * Group messages by date for display
 * @param messages - Array of chat messages
 * @returns Record with date keys and message arrays
 */
export const groupMessagesByDate = (messages: ChatMessage[]): Record<string, ChatMessage[]> => {
  return messages.reduce((groups, message) => {
    const date = new Date(message.timestamp).toLocaleDateString();
    
    if (!groups[date]) {
      groups[date] = [];
    }
    
    groups[date].push(message);
    return groups;
  }, {} as Record<string, ChatMessage[]>);
};

/**
 * Sort messages by timestamp (oldest first)
 * @param messages - Array of chat messages
 * @returns Sorted array
 */
export const sortMessagesByTime = (messages: ChatMessage[]): ChatMessage[] => {
  return [...messages].sort((a, b) => {
    return new Date(a.timestamp).getTime() - new Date(b.timestamp).getTime();
  });
};

/**
 * Build a prompt with context from previous messages
 * @param messages - Array of previous messages for context
 * @param customInstructions - Optional custom instructions
 * @returns Formatted prompt string for AI
 */
export const buildPromptWithContext = (
  messages: ChatMessage[], 
  customInstructions: string = ''
): string => {
  const context = messages.map(msg => {
    const role = msg.is_ai ? 'AI' : 'User';
    return `${role}: ${msg.message}`;
  }).join('\n\n');
  
  const instructions = customInstructions || 
    'You are a helpful assistant. Provide clear, accurate responses to the user.';
  
  return `${instructions}\n\nCONVERSATION HISTORY:\n${context}\n\nUser: `;
};

/**
 * Extract session title from first message
 * Generates a title from the user's first message
 * @param message - First message in conversation
 * @returns Generated session title
 */
export const generateSessionTitle = (message: string): string => {
  // Take first 5 words or 30 chars, whichever is shorter
  const titleText = message.split(' ').slice(0, 5).join(' ');
  if (titleText.length > 30) {
    return titleText.substring(0, 27) + '...';
  }
  return titleText;
};

/**
 * Create new chat session object
 * @param userId - User identifier
 * @param title - Optional session title
 * @returns Chat session object without ID
 */
export const createChatSession = (
  userId: string, 
  title?: string
): Omit<ChatSession, 'id'> => {
  const now = new Date().toISOString();
  
  return {
    user_id: userId,
    title: title || 'New conversation',
    started_at: now,
    updated_at: now
  };
};

// Export type utilities
export type ChatMessageWithoutId = Omit<ChatMessage, 'id'>;
export type ChatSessionWithoutId = Omit<ChatSession, 'id'>;
export type ChatMessageUpdate = Partial<ChatMessage>;
export type ChatSessionUpdate = Partial<ChatSession>;
